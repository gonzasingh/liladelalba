# Copiá este archivo como ".env" y completalo con los datos de tu app web de Firebase
# (Configuración del proyecto > Tus apps > Configuración del SDK).
# En Vercel cargá estas mismas variables en Settings > Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
